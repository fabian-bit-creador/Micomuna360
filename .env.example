# MiComuna360 — variables de entorno
# Copiar a .env.local y completar. NUNCA commitear .env.local.

# ── Supabase (se conecta en Fase 3; dejar vacío mientras tanto) ──────────────
# URL del proyecto (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública (anon/publishable). Segura para el navegador solo con RLS activo.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave service_role: SOLO para scripts de servidor. Nunca exponer con NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=
